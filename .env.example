# Copy to .env.local for local development. On Cloud Run, set these as service variables.
# Never commit real values.

# Public address of the platform (no trailing slash). QR codes point here.
PLATFORM_URL=http://localhost:3000
# Optional: bare domain for restaurant sub-domains, e.g. dinexes.in (then royal-biryani.dinexes.in works)
PLATFORM_DOMAIN=
# Optional: 1 = let restaurants' own domains open their page (see README, "Custom domains")
CUSTOM_DOMAINS=

# Firebase web app (Firebase console -> Project settings -> Your apps -> Web app). These are public identifiers.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Web push key pair (Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates)
FIREBASE_VAPID_KEY=

# Server credentials. Not needed on Cloud Run (it uses the service's own identity).
# Elsewhere: base64 of a service account JSON key. SECRET.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Razorpay (Dashboard -> Account & Settings -> API keys). Leave empty to keep payments switched off.
RAZORPAY_KEY_ID=
# SECRET. Store in Secret Manager on Cloud Run.
RAZORPAY_KEY_SECRET=

# Local testing with the Firebase emulators only:
# USE_FIREBASE_EMULATORS=1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
